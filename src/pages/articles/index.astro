---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PAGES } from '../../consts';

const posts = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' });
---

<BaseLayout
  title={PAGES.articles.title}
  description={PAGES.articles.description}
  noindex={posts.length === 0}
>
  <h1>Articles</h1>
  {
    posts.length === 0 ? (
      <div class="soon" style="margin-top:2rem">
        <span class="label">// coming soon</span>
        <p>Notes on engineering leadership, streaming at scale, and building with AI agents. First post soon.</p>
      </div>
    ) : (
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>
            <a href={`/articles/${p.id}/`}>{p.data.title}</a>
          </li>
        ))}
      </ul>
    )
  }
  <p class="mono" style="margin-top:3rem"><a href="/rss.xml">RSS feed</a></p>
</BaseLayout>
