---
import ThemeToggle from './ThemeToggle.astro';
import { NAV, SITE } from '../consts';
const path = Astro.url.pathname;
---

<header class="site-header">
  <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
    {SITE.name}<span class="cursor" aria-hidden="true">▍</span>
  </a>
  <nav aria-label="Main">
    {
      NAV.map((item) => (
        <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
    <ThemeToggle />
  </nav>
</header>
